# Food Express Environment Configuration Example
# Copy this file to .env and configure your database settings

# Database Settings ('mysql' or 'sqlite')
DB_ENGINE=mysql
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=your_mysql_password
MYSQL_DB=foodexpress

# Flask API Configuration
FLASK_HOST=127.0.0.1
FLASK_PORT=5000
API_BASE_URL=http://127.0.0.1:5000/api
SECRET_KEY=food-express-secret-key-2026
